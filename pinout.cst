// =============================================================================
// Pin Constraint File – Tang Nano 9K PID Motor Controller over Ethernet
// File: pinout.cst
//
// Hardware:
//   Board  : Sipeed Tang Nano 9K (Gowin GW1NR-9)
//   PHY    : LAN8720 RMII module
//   Motor  : External H-bridge (L298N / DRV8833 / TB6612)
//   Encoder: Quadrature (A/B lines) 3.3V compatible
// =============================================================================

// ============================================================
// System Clock (27 MHz onboard crystal – kept but unused in RTL)
// ============================================================
IO_LOC  "CLK"  52;
IO_PORT "CLK"  IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ============================================================
// RMII REF_CLK – 50 MHz from LAN8720 INT/REFCLK output
// MUST be on a global clock-capable pin (GCLK region)
// ============================================================
IO_LOC  "CLK50"           38;
IO_PORT "CLK50"           IO_TYPE=LVCMOS33;

// ============================================================
// RMII TX (FPGA → LAN8720)
// ============================================================
IO_LOC  "RMII_TXD[0]"    77;
IO_PORT "RMII_TXD[0]"    IO_TYPE=LVCMOS33;

IO_LOC  "RMII_TXD[1]"    76;
IO_PORT "RMII_TXD[1]"    IO_TYPE=LVCMOS33;

IO_LOC  "RMII_TX_EN"     75;
IO_PORT "RMII_TX_EN"     IO_TYPE=LVCMOS33;

// ============================================================
// RMII RX (LAN8720 → FPGA)
// ============================================================
IO_LOC  "RMII_RXD[0]"    73;
IO_PORT "RMII_RXD[0]"    IO_TYPE=LVCMOS33;

IO_LOC  "RMII_RXD[1]"    72;
IO_PORT "RMII_RXD[1]"    IO_TYPE=LVCMOS33;

IO_LOC  "RMII_CRS_DV"    71;
IO_PORT "RMII_CRS_DV"    IO_TYPE=LVCMOS33;

IO_LOC  "RMII_RX_ER"     74;
IO_PORT "RMII_RX_ER"     IO_TYPE=LVCMOS33;

// ============================================================
// MDIO management bus (MDC driven LOW = PHY in strap mode)
// ============================================================
IO_LOC  "RMII_MDC"       68;
IO_PORT "RMII_MDC"       IO_TYPE=LVCMOS33;

IO_LOC  "RMII_MDIO"      69;
IO_PORT "RMII_MDIO"      IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ============================================================
// Motor Control outputs
//   PWM_OUT   → H-bridge EN/PWM input
//   MOTOR_DIR → H-bridge IN1 (IN2 = ~MOTOR_DIR, invert externally
//               or use two separate outputs if H-bridge needs it)
// ============================================================
IO_LOC  "PWM_OUT"        25;
IO_PORT "PWM_OUT"        IO_TYPE=LVCMOS33;

IO_LOC  "MOTOR_DIR"      26;
IO_PORT "MOTOR_DIR"      IO_TYPE=LVCMOS33;

// ============================================================
// Quadrature Encoder inputs
//   Use 100 Ω series resistors to protect FPGA IO.
//   If encoder is open-collector, add 10 kΩ pull-up to 3.3 V.
// ============================================================
IO_LOC  "ENC_A"          27;
IO_PORT "ENC_A"          IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "ENC_B"          28;
IO_PORT "ENC_B"          IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ============================================================
// Onboard LEDs (active LOW on Tang Nano 9K)
//   LED1 = heartbeat    (pin 11)
//   LED2 = TX activity  (pin 13)
//   LED3 = PID active   (pin 15)
// ============================================================
IO_LOC  "LED1"           11;
IO_PORT "LED1"           IO_TYPE=LVCMOS33;

IO_LOC  "LED2"           13;
IO_PORT "LED2"           IO_TYPE=LVCMOS33;

IO_LOC  "LED3"           15;
IO_PORT "LED3"           IO_TYPE=LVCMOS33;

// ============================================================
// Onboard Buttons (active LOW, internal pull-up)
//   BTN1 = reset button (S1)
// ============================================================
IO_LOC  "BTN1"           3;
IO_PORT "BTN1"           IO_TYPE=LVCMOS33 PULL_MODE=UP;